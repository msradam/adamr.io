---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { ABOUT } from "@consts";
---

<Layout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <Container>
    <div class="space-y-6">
      {
        /* The heading sits on the same left edge as every other page. The
          headshot moves beside the bio instead of pushing the h1 131px right,
          which was the one page that broke the site's single left edge. */
      }
      <header class="about-head">
        <h1 class="page-heading">Adam Rahman</h1>
        <p class="about-standfirst">
          Senior Software Engineer at Grafana Labs &middot; M.S. Computer
          Engineering, NYU Tandon &middot; B.A. Theater &amp; Computer Science,
          Wesleyan
        </p>
        <p class="about-standfirst about-standfirst--muted">
          Engineer, poet, and theatermaker.
        </p>
      </header>

      <div class="about-layout">
        <article class="prose about-prose">
          <p>
            I'm a Senior Software Engineer on the AI/ML team at <Link
              href="https://grafana.com"
              external>Grafana Labs</Link
            >, in New York. I got there by way of the mainframe. At <Link
              href="https://www.ibm.com/z"
              external>IBM</Link
            > I ported <Link href="https://grafana.com/oss/k6/" external
              >Grafana k6</Link
            > to z/OS and built resiliency testing for IBM Z.
          </p>
          <p>
            Outside work I build geospatial AI tools for humanitarian use:
            <Link href="/dev/dream-meridian">DreamMeridian</Link>, <Link
              href="/dev/amanat">amanat</Link
            >, and before those, routing for school-site planning at UNICEF.
            I've been working on this since I was an undergraduate.
          </p>
          <p>
            I studied Theater and Computer Science at <Link
              href="https://www.wesleyan.edu/"
              external>Wesleyan</Link
            > and I'm finishing an M.S. at <Link
              href="https://engineering.nyu.edu/"
              external>NYU Tandon</Link
            >. I write poems and make theater; the <Link href="/poetry"
              >poetry</Link
            > and <Link href="/theater">theater</Link> pages have those.
          </p>
        </article>

        <aside class="about-rail">
          <img
            class="about-portrait"
            src="/images/headshot.png"
            alt="Adam M. Rahman"
            width="200"
            height="200"
            loading="lazy"
          />
          <dl class="about-facts">
            <div class="fact-row">
              <dt>Based</dt>
              <dd>NYC &middot; Eastern Time</dd>
            </div>
            <div class="fact-row">
              <dt>Now</dt>
              <dd>AI/ML at Grafana Labs &middot; NYU Tandon</dd>
            </div>
            <div class="fact-row">
              <dt>Education</dt>
              <dd>Wesleyan &middot; Theater & CS &middot; 2020</dd>
            </div>
            <div class="fact-row">
              <dt>GitHub</dt>
              <dd>
                <Link href="https://github.com/msradam" external>msradam</Link>
              </dd>
            </div>
            <div class="fact-row">
              <dt>LinkedIn</dt>
              <dd>
                <Link href="https://linkedin.com/in/adamsrahman" external
                  >adamsrahman</Link
                >
              </dd>
            </div>
            <div class="fact-row">
              <dt>Medium</dt>
              <dd>
                <Link href="https://medium.com/@msradam" external>@msradam</Link
                >
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </Container>
</Layout>

<style>
  .about-head {
    padding-bottom: var(--space-6);
    border-bottom: var(--rule-1) solid var(--border-hairline);
    margin-bottom: var(--space-7);
  }
  .about-standfirst {
    margin: var(--space-3) 0 0;
    max-width: var(--measure-wide);
    font-size: var(--type-md);
    color: var(--text-body);
    text-wrap: pretty;
  }
  .about-standfirst--muted {
    font-size: var(--type-sm);
    color: var(--text-secondary);
  }
  .about-portrait {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1;
    object-fit: cover;
    border: var(--rule-1) solid var(--border-hairline);
    margin-bottom: var(--space-5);
  }

  .about-layout {
    display: grid;
    grid-template-columns: 1fr 160px;
    gap: 3rem;
    align-items: start;
  }

  .about-rail {
    padding-top: 0.25rem;
  }

  .about-facts {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .fact-row {
    display: flex;
    flex-direction: column;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .fact-row:first-child {
    border-top: 1px solid var(--rule);
  }

  .fact-row dt {
    font-family: var(--font-sans);
    font-size: var(--type-sm);
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--text-2);
    margin: 0;
  }

  .fact-row dd {
    font-family: var(--sans);
    font-size: 0.833rem;
    color: var(--text-2);
    margin: 0.15rem 0 0;
  }

  @media (max-width: 640px) {
    .about-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about-rail {
      order: -1;
    }
  }
</style>
