---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import Link from "@components/Link.astro";
import { ABOUT } from "@consts";
---

<Layout title={ABOUT.TITLE} description={ABOUT.DESCRIPTION}>
  <Container>
    <div class="space-y-6">
      <div
        class="flex flex-col gap-5 sm:flex-row sm:items-start"
        style="padding-bottom: 1.5rem; border-bottom: 1px solid var(--rule);"
      >
        <img
          src="/images/headshot.png"
          alt="Adam M. Rahman"
          class="size-24 shrink-0 object-cover"
          style="border: 1px solid var(--border-strong);"
        />
        <div>
          <h1 class="page-heading-sm">Adam Rahman</h1>
          <p class="body-text-sm" style="margin-top: 0.25rem;">
            Senior Software Engineer at Grafana Labs &middot; M.S. Computer
            Engineering, NYU Tandon &middot; B.A. Theater & Computer Science,
            Wesleyan
          </p>
          <p class="body-text-xs" style="margin-top: 0.35rem;">
            Engineer, poet, and theatermaker. My work keeps returning to the
            same questions: who gets seen, who gets counted, and the dignity of
            people who cannot opt out.
          </p>
        </div>
      </div>

      <div class="about-layout">
        <article class="prose about-prose">
          <p>
            I'm a Senior Software Engineer on the AI/ML team at <Link
              href="https://grafana.com"
              external>Grafana Labs</Link
            >, in New York. I got there by way of the mainframe. At <Link
              href="https://www.ibm.com/z"
              external>IBM</Link
            > I ported <Link href="https://grafana.com/oss/k6/" external
              >Grafana k6</Link
            > to z/OS and built resiliency testing for IBM Z.
          </p>
          <p>
            Outside work I build geospatial AI tools for humanitarian use:
            <Link href="/dev/dream-meridian">DreamMeridian</Link>, <Link
              href="/dev/amanat">amanat</Link
            >, and before those, routing for school-site planning at UNICEF.
            It's what I've worked on since I was an undergraduate: who gets
            seen, who gets counted, and what systems do to people who can't opt
            out.
          </p>
          <p>
            I studied Theater and Computer Science at <Link
              href="https://www.wesleyan.edu/"
              external>Wesleyan</Link
            > and I'm finishing an M.S. at <Link
              href="https://engineering.nyu.edu/"
              external>NYU Tandon</Link
            >. I write poems and make theater; the <Link href="/poetry"
              >poetry</Link
            > and <Link href="/theater">theater</Link> pages have those.
          </p>
        </article>

        <aside class="about-rail">
          <dl class="about-facts">
            <div class="fact-row">
              <dt>Based</dt>
              <dd>NYC &middot; Eastern Time</dd>
            </div>
            <div class="fact-row">
              <dt>Now</dt>
              <dd>AI/ML at Grafana Labs &middot; NYU Tandon</dd>
            </div>
            <div class="fact-row">
              <dt>Education</dt>
              <dd>Wesleyan &middot; Theater & CS &middot; 2020</dd>
            </div>
            <div class="fact-row">
              <dt>GitHub</dt>
              <dd>
                <Link href="https://github.com/msradam" external>msradam</Link>
              </dd>
            </div>
            <div class="fact-row">
              <dt>LinkedIn</dt>
              <dd>
                <Link href="https://linkedin.com/in/adamsrahman" external
                  >adamsrahman</Link
                >
              </dd>
            </div>
            <div class="fact-row">
              <dt>Medium</dt>
              <dd>
                <Link href="https://medium.com/@msradam" external>@msradam</Link
                >
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </Container>
</Layout>

<style>
  .about-layout {
    display: grid;
    grid-template-columns: 1fr 160px;
    gap: 3rem;
    align-items: start;
  }

  .about-rail {
    padding-top: 0.25rem;
  }

  .about-facts {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .fact-row {
    display: flex;
    flex-direction: column;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
  }

  .fact-row:first-child {
    border-top: 1px solid var(--rule);
  }

  .fact-row dt {
    font-family: var(--font-sans);
    font-size: var(--type-sm);
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--text-2);
    margin: 0;
  }

  .fact-row dd {
    font-family: var(--sans);
    font-size: 0.833rem;
    color: var(--text-2);
    margin: 0.15rem 0 0;
  }

  @media (max-width: 640px) {
    .about-layout {
      grid-template-columns: 1fr;
      gap: 2rem;
    }

    .about-rail {
      order: -1;
    }
  }
</style>
