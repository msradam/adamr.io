---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { DESIGN } from "@consts";

const theaterWork = [
  {
    src: "/images/design/anandi.jpg",
    alt: "Anandi production poster",
    title: "Anandi",
    meta1: "Thesis film",
    meta2: "Dir. Thanmye Lagudu · 2019",
  },
  {
    src: "/images/design/disgraced.png",
    alt: "Disgraced production poster",
    title: "Disgraced",
    meta1: "Second Stage · Director & designer",
    meta2: "Malcolm X House · 2018",
  },
  {
    src: "/images/design/esque.jpg",
    alt: "What the Esque production poster",
    title: "What the Esque",
    meta1: "Queer film + arts show",
    meta2: "Westco Café · 2018",
  },
  {
    src: "/images/design/papiyon.png",
    alt: "La Violecion of My Papiyon production poster",
    title: "La Violecion of My Papiyon",
    meta1: "By Arline Pierre-Louis",
    meta2: "Patricelli '92 Theater · 2017",
  },
  {
    src: "/images/design/rhino.png",
    alt: "Rhinoceros production poster",
    title: "Rhinoceros",
    meta1: "Ionesco · Asst. director & designer",
    meta2: "Second Stage · 2018",
  },
];

const productWork = [
  {
    src: "/images/riprap-nyc.png",
    alt: "Riprap NYC flood-exposure briefing interface",
    title: "Riprap",
    meta1: "Briefing UI",
    meta2: "Civic AI · 2026",
  },
  {
    src: "/images/ariadne-nyc.png",
    alt: "Ariadne NYC accessible routing interface",
    title: "Ariadne NYC",
    meta1: "Route planner interface",
    meta2: "Geospatial AI · 2026",
  },
];

const marpThemes = [
  {
    src: "/images/marp-carbon.png",
    alt: "Carbon Marp theme title slide",
    title: "Carbon",
    meta1: "IBM Carbon Design System",
    meta2: "2026",
  },
  {
    src: "/images/marp-neobrutalism.png",
    alt: "Neobrutalism Marp theme title slide",
    title: "Neobrutalism",
    meta1: "Thick borders · Space Grotesk",
    meta2: "2026",
  },
  {
    src: "/images/marp-tufte.png",
    alt: "Tufte Marp theme title slide",
    title: "Tufte",
    meta1: "Edward Tufte · ET Book",
    meta2: "2026",
  },
  {
    src: "/images/marp-bold.png",
    alt: "Bold Marp theme title slide",
    title: "Bold",
    meta1: "Bold Design System · UFSC",
    meta2: "2026",
  },
];

const papiyonPhotos = [
  {
    src: "/images/theater/papiyon-1.jpg",
    alt: "La Violecion of My Papiyon production photo",
  },
  {
    src: "/images/theater/papiyon-2.jpg",
    alt: "La Violecion of My Papiyon production photo",
  },
  {
    src: "/images/theater/papiyon-3.jpg",
    alt: "La Violecion of My Papiyon production photo",
  },
  {
    src: "/images/theater/papiyon-4.jpg",
    alt: "La Violecion of My Papiyon production photo",
  },
];
---

<Layout title={DESIGN.TITLE} description={DESIGN.DESCRIPTION}>
  <Container>
    <div class="space-y-8">
      <div>
        <h1
          class="page-heading"
          style="margin-top: 0.5rem; margin-bottom: 0.5rem;"
        >
          Design
        </h1>
        <p class="body-text-sm">
          Posters and programs for theater and film at Wesleyan,
          2017&ndash;2019. Design systems, including Lokta and the one this site
          runs on now. Interface work from current projects.
        </p>
      </div>

      <section class="space-y-4">
        <div class="section-header">
          <h2 class="capsule-label">Design systems · 2026</h2>
        </div>
        <a
          href="https://github.com/msradam/lokta"
          target="_blank"
          rel="noopener noreferrer"
          class="ds-feature"
        >
          <div class="ds-shot">
            <img
              src="/images/design/lokta.png"
              alt="Lokta design system: the Lokta wordmark, the stock switcher, and a summary of its type, colour, stocks, and tokens"
              loading="lazy"
            />
          </div>
          <div class="ds-body">
            <div class="poster-name">Lokta</div>
            <p class="ds-desc">
              An editorial UI design system that treats the screen as a printed
              page, after the layout of Sachiyo Harada's <em
                >Cuisine on Screen</em
              > (Prestel). Warm paper stocks, marigold as the hero pigment, Archivo
              / Spline Sans Mono / Source Serif 4, and a flat, hard-edged component
              layer. Ships tokens (CSS/SCSS/JS), components, and Marp, Typst, and
              Mermaid themes. WCAG 2.2 AA. The predecessor to Capsule; this site ran
              on it through 2026.
            </p>
            <div class="poster-detail">
              Creator · Tokens, components, themes · 2026
            </div>
          </div>
        </a>
      </section>

      <section class="space-y-4" style="margin-top: 2rem;">
        <div class="section-header">
          <h2 class="capsule-label">
            Theater &amp; film posters · Wesleyan 2017–2019
          </h2>
        </div>
        <div class="poster-grid">
          {
            theaterWork.map((item) => (
              <div class="poster-item">
                <button
                  class="lightbox-trigger poster-frame"
                  data-src={item.src}
                  data-alt={item.alt}
                  aria-label={`View ${item.title} poster`}
                >
                  <img
                    src={item.src}
                    alt={item.alt}
                    class="poster-img"
                    loading="lazy"
                  />
                </button>
                <div class="poster-meta">
                  <div class="poster-name">{item.title}</div>
                  <div class="poster-detail">{item.meta1}</div>
                  <div class="poster-detail">{item.meta2}</div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="space-y-4" style="margin-top: 2rem;">
        <div class="section-header">
          <h2 class="capsule-label">Product &amp; interface · 2025–</h2>
        </div>
        <div class="poster-grid">
          {
            productWork.map((item) => (
              <div class="poster-item">
                <button
                  class="lightbox-trigger poster-frame interface-frame"
                  data-src={item.src}
                  data-alt={item.alt}
                  aria-label={`View ${item.title} screenshot`}
                >
                  <img
                    src={item.src}
                    alt={item.alt}
                    class="poster-img"
                    loading="lazy"
                  />
                </button>
                <div class="poster-meta">
                  <div class="poster-name">{item.title}</div>
                  <div class="poster-detail">{item.meta1}</div>
                  <div class="poster-detail">{item.meta2}</div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="space-y-4" style="margin-top: 2rem;">
        <div class="section-header">
          <h2 class="capsule-label">Presentation themes · Marp</h2>
        </div>
        <p class="body-text-xs" style="color: var(--text-muted);">
          Open-source <a
            href="https://marp.app"
            target="_blank"
            rel="noopener noreferrer"
            class="content-link">Marp</a
          >
          themes, each with light and dark variants and Mermaid diagram theming.
        </p>
        <div class="theme-grid">
          {
            marpThemes.map((item) => (
              <div class="poster-item">
                <button
                  class="lightbox-trigger poster-frame theme-frame"
                  data-src={item.src}
                  data-alt={item.alt}
                  aria-label={`View ${item.title} theme slide`}
                >
                  <img
                    src={item.src}
                    alt={item.alt}
                    class="poster-img"
                    loading="lazy"
                  />
                </button>
                <div class="poster-meta">
                  <div class="poster-name">{item.title}</div>
                  <div class="poster-detail">{item.meta1}</div>
                  <div class="poster-detail">{item.meta2}</div>
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <section class="space-y-4" style="margin-top: 2rem;">
        <div class="section-header">
          <h2 class="capsule-label">Production photos</h2>
        </div>
        <p class="body-text-xs" style="color: var(--text-muted);">
          Set design for <em>La Violecion of My Papiyon</em> by Arline Pierre-Louis.
          SHADES, Patricelli '92 Theater, Wesleyan University, April 2018. Photos
          by Dani Smotrich-Barr.
        </p>
        <div class="photo-grid">
          {
            papiyonPhotos.map((item) => (
              <button
                class="lightbox-trigger photo-frame"
                data-src={item.src}
                data-alt={item.alt}
                aria-label="View production photo"
              >
                <img
                  src={item.src}
                  alt={item.alt}
                  class="photo-img"
                  loading="lazy"
                />
              </button>
            ))
          }
        </div>
      </section>
    </div>

    <dialog id="lightbox" class="lightbox-dialog">
      <button id="lightbox-close" class="lightbox-close" aria-label="Close">
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          class="size-5"
        >
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
      {
        /* No src until a poster is chosen. An <img src=""> ships a broken-image
          box and is what detectors flag; the element is hidden until the
          lightbox script fills it. */
      }
      {
        /* No <img> in the markup at all: an image element with no usable source
          is what detectors flag as broken, and it is one the reader can never
          see. The lightbox script creates it on first open. */
      }
      <div id="lightbox-slot"></div>
    </dialog>
  </Container>
</Layout>

<style>
  .lightbox-img {
    max-height: 90dvh;
    max-width: 100%;
    object-fit: contain;
    border-radius: var(--radius-surface);
    display: block;
  }

  /* The lightbox is a Capsule surface like everything else: the only depth cue
     is --scrim, a veil of the PAGE colour, never a dark wash; radius 0 on a
     surface; a square 44px control; one 180ms beat. */
  .lightbox-dialog {
    margin: 0;
    max-width: 100dvw;
    max-height: 100dvh;
    padding: var(--space-4);
    background: transparent;
    border: 0;
  }
  .lightbox-dialog::backdrop {
    background: var(--scrim);
  }
  .lightbox-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--target-touch);
    height: var(--target-touch);
    border-radius: var(--radius-surface);
    border: var(--rule-1) solid var(--border-hairline);
    background: var(--surface-page);
    color: var(--text-primary);
    cursor: pointer;
    transition: background-color var(--beat) var(--ease-paper);
  }
  .lightbox-close:hover {
    background: var(--state-hover);
  }
  .lightbox-close:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring);
    outline-offset: var(--focus-offset);
  }

  .ds-feature {
    display: block;
    border: 1px solid var(--rule);
    text-decoration: none;
    transition: border-color var(--beat) var(--ease-paper);
  }

  .ds-feature:hover {
    border-color: var(--rule-strong);
  }

  .ds-shot {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border-bottom: 1px solid var(--rule);
    background: var(--bg-alt);
  }

  .ds-shot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    display: block;
  }

  .ds-body {
    padding: 1rem 1.25rem 1.25rem;
  }

  .ds-desc {
    font-family: var(--sans);
    font-size: 0.85rem;
    line-height: 1.55;
    color: var(--text-2);
    margin: 0.35rem 0 0.6rem;
    max-width: 60ch;
  }

  .poster-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem 1.25rem;
  }

  .poster-frame {
    display: block;
    width: 100%;
    aspect-ratio: 5/8;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 0;
    cursor: zoom-in;
    background: var(--bg-alt);
    padding: 0;
  }

  .poster-img {
    width: 100%;
    height: 100%;
    /* A poster is the work, not a texture: show all of it. Cover was cutting
       25% off the taller sheets. Theme cards override this below, where the
       source already matches the frame. */
    object-fit: contain;
    transition: opacity var(--beat) var(--ease-paper);
    display: block;
  }

  .poster-frame:hover .poster-img {
    opacity: 0.88;
  }

  .poster-meta {
    margin-top: 0.6rem;
  }

  .poster-name {
    font-family: var(--sans);
    font-size: 0.9rem;
    font-weight: 700;
    color: var(--text);
    line-height: 1.3;
  }

  .poster-detail {
    font-family: var(--font-sans);
    font-size: var(--meta);
    color: var(--text-muted);
    letter-spacing: 0.01em;
    text-transform: none;
    margin-top: 0.2rem;
    line-height: 1.5;
  }

  dialog[open] {
    display: flex;
    position: fixed;
    inset: 0;
    z-index: 50;
    width: 100dvw;
    max-width: 100dvw;
    height: 100dvh;
    max-height: 100dvh;
    align-items: center;
    justify-content: center;
    animation: fade-in var(--beat) var(--ease-paper);
  }
  dialog[open]::backdrop {
    animation: fade-in var(--beat) var(--ease-paper);
  }
  @keyframes fade-in {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
  dialog[open] img {
    animation: fade-in var(--beat) var(--ease-paper);
  }

  .interface-frame {
    /* Both captures are 16/9; matching the frame removes the matting. */
    aspect-ratio: 16/9;
  }

  .theme-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem 1.25rem;
  }

  .theme-frame {
    aspect-ratio: 16/9;
    background: #ffffff;
  }

  .theme-frame .poster-img {
    object-fit: cover;
    object-position: top left;
  }

  .photo-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.75rem;
  }

  .photo-frame {
    display: block;
    width: 100%;
    aspect-ratio: 3/2;
    overflow: hidden;
    border: 1px solid var(--rule);
    border-radius: 0;
    cursor: zoom-in;
    background: #0c0c0c;
    padding: 0;
  }

  .photo-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity var(--beat) var(--ease-paper);
    display: block;
  }

  .photo-frame:hover .photo-img {
    opacity: 0.88;
  }

  @media (max-width: 640px) {
    .poster-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1rem;
    }

    .photo-grid {
      grid-template-columns: 1fr;
    }

    .theme-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  function initLightbox() {
    const dialog = document.getElementById("lightbox") as HTMLDialogElement;
    const slot = document.getElementById("lightbox-slot") as HTMLElement;
    const img = document.createElement("img");
    img.className = "lightbox-img";
    img.alt = "";
    slot.appendChild(img);
    const closeBtn = document.getElementById("lightbox-close");

    document.querySelectorAll(".lightbox-trigger").forEach((btn) => {
      btn.addEventListener("click", () => {
        const src = (btn as HTMLElement).dataset.src || "";
        const alt = (btn as HTMLElement).dataset.alt || "";
        img.src = src;
        img.alt = alt;
        dialog.showModal();
      });
    });

    dialog.addEventListener("close", () => {
      img.removeAttribute("src");
    });
    closeBtn?.addEventListener("click", () => dialog.close());
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog) dialog.close();
    });
  }

  document.addEventListener("DOMContentLoaded", initLightbox);
  document.addEventListener("astro:after-swap", initLightbox);
</script>
