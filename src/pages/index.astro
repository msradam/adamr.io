---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import { getCollection } from "astro:content";
import FormattedDate from "@components/FormattedDate.astro";

const allProjects = (await getCollection("dev")).filter(
  (p) => !p.data.draft && !p.data.hidden,
);

const featuredRank = (p: (typeof allProjects)[number]) =>
  p.data.featuredRank ?? Number.MAX_SAFE_INTEGER;
const featured = allProjects
  .filter((p) => p.data.featured)
  .sort((a, b) => featuredRank(a) - featuredRank(b))
  .slice(0, 3);

const featuredIds = new Set(featured.map((p) => p.id));
const recent = allProjects
  .filter((p) => !featuredIds.has(p.id))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <Container>
    <section class="hero">
      <h1>
        Hi! I'm Adam.
        <span class="wave" role="img" aria-label="waving hand">👋</span>
      </h1>
      <p class="lede">
        Software engineer, poet, and theatermaker. I work on the AI/ML team at
        <a
          class="capsule-link"
          href="https://grafana.com"
          target="_blank"
          rel="noopener noreferrer">Grafana Labs</a
        >. Outside that I build civic-AI tools, publish poetry, and make
        theater.
      </p>
      <p class="standing">
        Previously IBM Z · M.S. at NYU Tandon · poems in <em>Barzakh</em>,
        <em>Collide-oscope</em> and <em>Four Tulips</em> · New York.
      </p>
    </section>

    <section aria-labelledby="work-h">
      <h2 class="capsule-label section-h" id="work-h">Work</h2>
      <ul class="entries">
        {
          featured.map((p) => (
            <li>
              <a class="entry-title" href={`/dev/${p.id}`}>
                {p.data.title}
              </a>
              <p class="entry-note">{p.data.excerpt ?? p.data.description}</p>
              {(p.data.role || p.data.venue) && (
                <p class="entry-meta">
                  {[p.data.role, p.data.venue].filter(Boolean).join(" · ")}
                </p>
              )}
            </li>
          ))
        }
      </ul>
      <a class="capsule-link more" href="/dev">All projects</a>
    </section>

    <section aria-labelledby="recent-h">
      <h2 class="capsule-label section-h" id="recent-h">Also building</h2>
      <ol class="rows">
        {
          recent.map((p) => (
            <li>
              <a class="row-title" href={`/dev/${p.id}`}>
                {p.data.title}
              </a>
              <span class="row-when">
                <FormattedDate date={p.data.date} />
              </span>
            </li>
          ))
        }
      </ol>
    </section>

    <section aria-labelledby="writing-h">
      <h2 class="capsule-label section-h" id="writing-h">Writing</h2>
      <ol class="rows">
        {
          posts.map((p) => (
            <li>
              <a class="row-title" href={`/blog/${p.id}`}>
                {p.data.title}
              </a>
              <span class="row-when">
                <FormattedDate date={p.data.date} />
              </span>
            </li>
          ))
        }
      </ol>
      <a class="capsule-link more" href="/blog">Everything</a>
    </section>

    <section class="contact" aria-labelledby="contact-h">
      <h2 class="capsule-label section-h" id="contact-h">Elsewhere</h2>
      <p class="contact-line">
        Not looking for work, but always glad to hear from people building where
        it matters who gets seen and counted.
      </p>
      <p class="contact-links">
        {
          SOCIALS.map((s, i) => (
            <>
              {i > 0 && (
                <span class="sep" aria-hidden="true">
                  ·
                </span>
              )}
              <a
                class="capsule-link"
                href={s.HREF}
                rel="me noopener noreferrer"
              >
                {s.NAME}
              </a>
            </>
          ))
        }
      </p>
    </section>
  </Container>
</Layout>

<style>
  /* Rhythm does the work the boxes used to: tight inside a group, generous
     between sections. Nothing on this page is boxed, filled, or counted. */
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-7);
  }
  .wave {
    font-size: 0.7em;
    margin-left: 0.24em;
    /* Still. Capsule allows no loop, and a greeting does not need one. */
  }
  .hero h1 {
    font-family: var(--font-head);
    font-size: var(--text-display);
    font-weight: var(--font-weight-display);
    line-height: 1.06;
    letter-spacing: var(--track-display);
    color: var(--text-primary);
    margin: 0;
    text-wrap: balance;
  }
  .lede {
    margin: 0;
    max-width: var(--measure-wide);
    font-size: var(--text-lede);
    line-height: var(--lh-relaxed);
    color: var(--text-body);
    text-wrap: pretty;
  }

  section + section {
    margin-top: var(--space-8);
  }
  .section-h {
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: var(--rule-1) solid var(--border-hairline);
  }

  /* Work: a list with room, not a grid of cards. */
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entries > li + li {
    margin-top: var(--space-5);
  }
  .entry-title {
    font-family: var(--font-head);
    font-size: var(--type-lg);
    font-weight: var(--font-weight-display);
    letter-spacing: var(--track-display);
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: var(--rule-1) solid transparent;
  }
  .entry-title:hover {
    border-bottom-color: var(--accent-ink);
  }
  .entry-note {
    margin: var(--space-2) 0 0;
    max-width: var(--measure-wide);
    color: var(--text-body);
    text-wrap: pretty;
  }
  .entry-meta {
    margin: var(--space-1) 0 0;
    font-family: var(--font-label);
    font-size: var(--type-xs);
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  .more {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-touch);
    margin-top: var(--space-4);
    font-family: var(--font-label);
    font-size: var(--type-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contact-line {
    margin: 0 0 var(--space-3);
    max-width: var(--measure-wide);
    color: var(--text-body);
  }
  .contact-links {
    margin: 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    align-items: center;
  }
  .contact-links .sep {
    color: var(--text-muted);
  }
</style>
