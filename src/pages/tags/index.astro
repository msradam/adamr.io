---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
/* Tags arrive lowercased from the collection schema; sort with a collator
   anyway so a stray capital can never float to the top of the list. */
const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort(
  (a, b) => a.localeCompare(b, "en", { sensitivity: "base" }),
);
---

<Layout title="Tags" description="List of tags used.">
  <Container>
    <div class="space-y-6">
      <h1 class="page-h">Tags</h1>
      <p class="lede">Every subject across the writing.</p>
      <div class="flex flex-wrap gap-1.5">
        {
          tags.map((tag) => (
            <a href={`/tags/${tag}`} class="capsule-chip">
              {tag}{" "}
              <span style="opacity: 0.6;">
                ({posts.filter((post) => post.data.tags?.includes(tag)).length})
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</Layout>

<style>
  .lede {
    margin: 0 0 var(--space-6);
    max-width: var(--measure-wide);
    font-size: var(--text-lede);
    color: var(--text-body);
    text-wrap: pretty;
  }
  .page-h {
    font-family: var(--font-head);
    font-size: var(--text-display);
    font-weight: var(--font-weight-display);
    line-height: 1.08;
    letter-spacing: var(--track-display);
    color: var(--text-primary);
    margin: 0 0 var(--space-5);
  }
</style>
