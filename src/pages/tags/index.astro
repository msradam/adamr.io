---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";

const posts = await getCollection("blog", ({ data }) => !data.draft);
/* Tags arrive lowercased from the collection schema; sort with a collator
   anyway so a stray capital can never float to the top of the list. */
const tags = [...new Set(posts.flatMap((post) => post.data.tags || []))].sort(
  (a, b) => a.localeCompare(b, "en", { sensitivity: "base" }),
);
---

<Layout title="Tags" description="List of tags used.">
  <Container>
    <div class="space-y-6">
      <h1 class="capsule-label page-label">All tags</h1>
      <div class="flex flex-wrap gap-1.5">
        {
          tags.map((tag) => (
            <a href={`/tags/${tag}`} class="capsule-chip">
              {tag}{" "}
              <span style="opacity: 0.6;">
                ({posts.filter((post) => post.data.tags?.includes(tag)).length})
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </Container>
</Layout>

<style>
  .page-label {
    display: block;
    margin: 0 0 var(--space-4);
  }
</style>
