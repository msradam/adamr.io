---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { PROJECTS } from "@consts";

const all = (await getCollection("dev"))
  .filter((p) => !p.data.draft && !p.data.hidden)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const rank = (p: (typeof all)[number]) =>
  p.data.featuredRank ?? Number.MAX_SAFE_INTEGER;
const featured = all
  .filter((p) => p.data.featured)
  .sort((a, b) => rank(a) - rank(b));
const rest = all.filter((p) => !p.data.featured);
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div data-pagefind-ignore>
      <header class="head">
        <h1>Projects</h1>
        <p class="lede">
          Civic-AI tools, open-source tooling for the mainframe, and geospatial
          systems.
        </p>
      </header>

      <section aria-labelledby="sel-h">
        <h2 class="capsule-label section-h" id="sel-h">Selected</h2>
        <ul class="entries">
          {
            featured.map((p) => (
              <li>
                <a class="entry-title" href={`/dev/${p.id}`}>
                  {p.data.title}
                </a>
                <p class="entry-note">{p.data.excerpt ?? p.data.description}</p>
                <p class="entry-meta">
                  {[p.data.role, p.data.venue].filter(Boolean).join(" · ")}
                </p>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="rest-h">
        <h2 class="capsule-label section-h" id="rest-h">Everything else</h2>
        <ol class="rows">
          {
            rest.map((p) => (
              <li>
                <a class="row-title" href={`/dev/${p.id}`}>
                  {p.data.title}
                </a>
                <span class="row-when">
                  <FormattedDate date={p.data.date} />
                </span>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </Container>
</Layout>

<style>
  /* Standalone links carry a 44px target. Links inside a running sentence do
     not: WCAG 2.5.8 exempts a target constrained by the line-height of the
     text around it, and padding one would overlap the lines above and below. */
  .entry-title {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-touch);
  }

  .head {
    padding-bottom: var(--space-6);
  }
  .head h1 {
    font-family: var(--font-head);
    font-size: var(--text-display);
    font-weight: var(--font-weight-display);
    line-height: 1.08;
    letter-spacing: var(--track-display);
    color: var(--text-primary);
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }
  .lede {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--text-lede);
    color: var(--text-body);
    text-wrap: pretty;
  }
  section + section {
    margin-top: var(--space-8);
  }
  .section-h {
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: var(--rule-1) solid var(--border-hairline);
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entries > li + li {
    margin-top: var(--space-5);
  }
  .entry-title {
    font-family: var(--font-head);
    font-size: var(--type-lg);
    font-weight: var(--font-weight-display);
    letter-spacing: var(--track-display);
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: var(--rule-1) solid transparent;
  }
  .entry-title:hover {
    border-bottom-color: var(--accent-ink);
  }
  .entry-note {
    margin: var(--space-2) 0 0;
    max-width: var(--measure);
    color: var(--text-body);
    text-wrap: pretty;
  }
  .entry-meta {
    margin: var(--space-1) 0 0;
    font-family: var(--font-sans);
    font-size: var(--type-xs);
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
</style>
