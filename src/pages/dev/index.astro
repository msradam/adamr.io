---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { PROJECTS } from "@consts";

const all = (await getCollection("dev"))
  .filter((p) => !p.data.draft && !p.data.hidden)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const rank = (p: (typeof all)[number]) =>
  p.data.featuredRank ?? Number.MAX_SAFE_INTEGER;
const featured = all
  .filter((p) => p.data.featured)
  .sort((a, b) => rank(a) - rank(b));
const rest = all.filter((p) => !p.data.featured);

/* Static poster frames, 640px WebP. The animated originals stay on the detail
   pages; a 4 MB autoplaying loop has no business in an index row. */
const THUMBS: Record<string, string> = {
  "dream-meridian": "/images/thumbs/dream-meridian.webp",
  amanat: "/images/thumbs/amanat.webp",
  kassi: "/images/thumbs/kassi.webp",
  "xk6-tn3270": "/images/thumbs/xk6-tn3270.webp",
  "xk6-llm": "/images/thumbs/xk6-llm.webp",
  "riprap-nyc": "/images/thumbs/riprap-nyc.webp",
  kassandra: "/images/thumbs/kassandra.webp",
  theodosia: "/images/thumbs/theodosia.webp",
  leavitt: "/images/thumbs/leavitt.webp",
  fromjcl: "/images/thumbs/fromjcl.webp",
};
---

<Layout title={PROJECTS.TITLE} description={PROJECTS.DESCRIPTION}>
  <Container>
    <div data-pagefind-ignore>
      <header class="head">
        <h1>Projects</h1>
        <p class="lede">
          Civic-AI tools, open-source tooling for the mainframe, and geospatial
          systems.
        </p>
      </header>

      <section aria-labelledby="sel-h">
        <h2 class="capsule-label section-h" id="sel-h">Selected</h2>
        <ul class="entries">
          {
            featured.map((p) => (
              <li class:list={["entry", THUMBS[p.id] && "has-thumb"]}>
                {THUMBS[p.id] && (
                  <a
                    class="thumb"
                    href={`/dev/${p.id}`}
                    tabindex="-1"
                    aria-hidden="true"
                  >
                    <img
                      src={THUMBS[p.id]}
                      alt=""
                      loading="lazy"
                      decoding="async"
                      width="640"
                      height="400"
                    />
                  </a>
                )}
                <div class="entry-body">
                  <a class="entry-title" href={`/dev/${p.id}`}>
                    {p.data.title}
                  </a>
                  <p class="entry-note">
                    {p.data.excerpt ?? p.data.description}
                  </p>
                  <p class="entry-meta">
                    {[p.data.role, p.data.venue].filter(Boolean).join(" · ")}
                  </p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section aria-labelledby="rest-h">
        <h2 class="capsule-label section-h" id="rest-h">Everything else</h2>
        <ol class="rows">
          {
            rest.map((p) => (
              <li>
                <a class="row-title" href={`/dev/${p.id}`}>
                  {p.data.title}
                </a>
                <span class="row-when">
                  <FormattedDate date={p.data.date} />
                </span>
              </li>
            ))
          }
        </ol>
      </section>
    </div>
  </Container>
</Layout>

<style>
  /* Standalone links carry a 44px target. Links inside a running sentence do
     not: WCAG 2.5.8 exempts a target constrained by the line-height of the
     text around it, and padding one would overlap the lines above and below. */
  .entry-title {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-touch);
  }

  /* The page opening gets the one big break; sections after it sit closer. */
  .head {
    padding-bottom: var(--space-8);
  }
  .head h1 {
    font-family: var(--font-head);
    font-size: var(--text-display);
    font-weight: var(--font-weight-display);
    line-height: 1.08;
    letter-spacing: var(--track-display);
    color: var(--text-primary);
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }
  .lede {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--text-lede);
    color: var(--text-body);
    text-wrap: pretty;
  }
  section + section {
    margin-top: var(--space-7);
  }
  .section-h {
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: var(--rule-1) solid var(--border-hairline);
  }
  .entries {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .entries > li + li {
    margin-top: var(--space-6);
  }

  /* A list with pictures, not a deck of cards: no box, no shadow, no radius.
     The image is a plate on the page, held only by the single 1px line. */
  .entry.has-thumb {
    display: grid;
    grid-template-columns: 13rem minmax(0, 1fr);
    gap: var(--space-5);
    align-items: start;
  }
  .thumb {
    display: block;
    border: var(--rule-1) solid var(--border-hairline);
    background: var(--surface-sunken);
    line-height: 0;
  }
  .thumb img {
    width: 100%;
    height: auto;
    /* 16/9 is what most of the captures already are, so they fill the frame
       exactly and only the odd sizes get matted. */
    aspect-ratio: 16 / 9;
    /* Contain, not cover: the near-square captures (xk6-llm, xk6-tn3270) lost
       34-41% of their frame to a landscape crop and read as dark static. The
       sunken ground behind mats whatever does not fill the box. */
    object-fit: contain;
    display: block;
  }
  .entry-body {
    min-width: 0;
  }
  @media (max-width: 640px) {
    .entry.has-thumb {
      grid-template-columns: 1fr;
      gap: var(--space-3);
    }
    /* Stacked, a full-bleed thumb turns a small desktop reference image into a
       phone-sized slab of dark screenshot. Cap it. */
    .thumb {
      max-width: 15rem;
    }
  }
  .entry-title {
    font-family: var(--font-head);
    font-size: var(--type-lg);
    font-weight: var(--font-weight-display);
    letter-spacing: var(--track-display);
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: var(--rule-1) solid transparent;
  }
  .entry-title:hover {
    border-bottom-color: var(--accent-ink);
  }
  .entry-note {
    margin: var(--space-2) 0 0;
    max-width: var(--measure);
    color: var(--text-body);
    text-wrap: pretty;
  }
  .entry-meta {
    margin: var(--space-1) 0 0;
    font-family: var(--font-sans);
    font-size: var(--type-xs);
    letter-spacing: normal;
    color: var(--text-muted);
  }
</style>
