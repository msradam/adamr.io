---
import { type CollectionEntry, getCollection, render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";

export async function getStaticPaths() {
  const projects = (await getCollection("dev")).filter(
    (p) => !p.data.draft && !p.data.hidden,
  );
  return projects.map((project) => ({
    params: { id: project.id },
    props: project,
  }));
}

type Props = CollectionEntry<"dev">;
const project = Astro.props;
const { Content } = await render(project);
const {
  title,
  description,
  role,
  stack,
  venue,
  recognition,
  repoURL,
  demoURL,
} = project.data;

const writeup = (await getCollection("blog")).find(
  (p) => p.id === project.id && !p.data.draft,
);
---

<Layout title={title} description={description}>
  <Container>
    <div style="margin-bottom: 2rem;">
      <BackToPrevious href="/dev">Dev</BackToPrevious>
    </div>

    <div class="space-y-6">
      <div>
        <h1 class="page-heading-lg">{title}</h1>
      </div>

      {
        (role ||
          stack ||
          venue ||
          recognition ||
          repoURL ||
          demoURL ||
          writeup) && (
          <dl class="meta" aria-label="Project details">
            {writeup && (
              <>
                <dt class="capsule-label">Writeup</dt>
                <dd>
                  <a href={`/blog/${writeup.id}`} class="capsule-link">
                    {writeup.data.title}
                  </a>
                </dd>
              </>
            )}
            {role && (
              <>
                <dt class="capsule-label">Role</dt>
                <dd>{role}</dd>
              </>
            )}
            {stack && stack.length > 0 && (
              <>
                <dt class="capsule-label">Stack</dt>
                <dd>{stack.join(", ")}</dd>
              </>
            )}
            {venue && (
              <>
                <dt class="capsule-label">Venue</dt>
                <dd>{venue}</dd>
              </>
            )}
            {recognition && (
              <>
                <dt class="capsule-label">Recognition</dt>
                <dd>{recognition}</dd>
              </>
            )}
            {(repoURL || demoURL) && (
              <>
                <dt class="capsule-label">Links</dt>
                <dd>
                  {repoURL && (
                    <a
                      href={repoURL}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="capsule-link"
                    >
                      Source
                    </a>
                  )}
                  {repoURL && demoURL && (
                    <span class="sep" aria-hidden="true">
                      {" "}
                      ·{" "}
                    </span>
                  )}
                  {demoURL && (
                    <a
                      href={demoURL}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="capsule-link"
                    >
                      Live
                    </a>
                  )}
                </dd>
              </>
            )}
          </dl>
        )
      }

      <article class="prose project-content">
        <Content />
      </article>

      <div class="article-end" aria-hidden="true">
        <span class="end-rule"></span>
      </div>
    </div>
  </Container>
</Layout>

<style>
  /* The sidecar was an accent-bordered box; it is a ruled definition list now.
     Labels in the label font, values in chrome, one 1px rule top and bottom. */
  .meta {
    display: grid;
    grid-template-columns: max-content minmax(0, 1fr);
    gap: var(--space-2) var(--space-5);
    margin: 0 0 var(--space-6);
    padding: var(--space-4) 0;
    border-top: var(--rule-1) solid var(--border-hairline);
    border-bottom: var(--rule-1) solid var(--border-hairline);
    max-width: var(--measure);
  }
  .meta dt {
    margin: 0;
  }
  .meta dd {
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--type-sm);
    color: var(--text-body);
  }
  .meta .sep {
    color: var(--text-muted);
  }
  @media (max-width: 640px) {
    .meta {
      grid-template-columns: 1fr;
      gap: var(--space-1);
    }
    .meta dd {
      margin-bottom: var(--space-3);
    }
  }
</style>
