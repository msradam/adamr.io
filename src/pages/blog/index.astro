---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { BLOG } from "@consts";

const all = (await getCollection("blog"))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const TOPICS: {
  key: "ai-infra" | "observability" | "essays";
  label: string;
}[] = [
  { key: "ai-infra", label: "AI infrastructure & agents" },
  { key: "observability", label: "Observability & tooling" },
  { key: "essays", label: "Essays & reflections" },
];

const byTopic = TOPICS.map(({ key, label }) => ({
  label,
  posts: all.filter((p) => p.data.topic === key),
})).filter((g) => g.posts.length > 0);

// Anything without a topic falls into a plain year archive rather than a
// catch-all bucket, so the grouping stays honest as the collection grows.
const untopiced = all.filter((p) => !p.data.topic);
const years = [
  ...new Set(untopiced.map((p) => p.data.date.getFullYear())),
].sort((a, b) => b - a);
---

<Layout title={BLOG.TITLE} description={BLOG.DESCRIPTION}>
  <Container>
    <div data-pagefind-ignore>
      <header class="head">
        <h1>Writing</h1>
        <p class="lede">
          Essays on AI infrastructure and observability, plus older pieces on
          cities, politics, and whatever I was reading at the time.
        </p>
      </header>

      {
        byTopic.map(({ label, posts }) => (
          <section aria-labelledby={`t-${label}`}>
            <h2 class="capsule-label section-h" id={`t-${label}`}>
              {label}
            </h2>
            <ol class="rows">
              {posts.map((post) => (
                <li>
                  <a class="row-title" href={`/blog/${post.id}`}>
                    {post.data.title}
                  </a>
                  <span class="row-when">
                    <FormattedDate date={post.data.date} />
                  </span>
                </li>
              ))}
            </ol>
          </section>
        ))
      }

      {
        years.map((y) => (
          <section aria-labelledby={`y-${y}`}>
            <h2 class="capsule-label section-h" id={`y-${y}`}>
              {y}
            </h2>
            <ol class="rows">
              {untopiced
                .filter((p) => p.data.date.getFullYear() === y)
                .map((post) => (
                  <li>
                    <a class="row-title" href={`/blog/${post.id}`}>
                      {post.data.title}
                    </a>
                    <span class="row-when">
                      <FormattedDate date={post.data.date} />
                    </span>
                  </li>
                ))}
            </ol>
          </section>
        ))
      }
    </div>
  </Container>
</Layout>

<style>
  /* The page opening gets the one big break; sections after it sit closer. */
  .head {
    padding-bottom: var(--space-8);
  }
  .head h1 {
    font-family: var(--font-head);
    font-size: var(--text-display);
    font-weight: var(--font-weight-display);
    line-height: 1.08;
    letter-spacing: var(--track-display);
    color: var(--text-primary);
    margin: 0 0 var(--space-3);
    text-wrap: balance;
  }
  .lede {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--text-lede);
    color: var(--text-body);
    text-wrap: pretty;
  }
  section + section {
    margin-top: var(--space-7);
  }
  .section-h {
    margin: 0 0 var(--space-3);
    padding-bottom: var(--space-2);
    border-bottom: var(--rule-1) solid var(--border-hairline);
  }
</style>
