---
/* The TOC is a rail, not a disclosure. An essay's sections have a real order,
   which is the one case where Capsule's rail idiom is literal. The active
   section is an inverted slab, not a colour change. */
export interface Heading {
  depth: number;
  slug: string;
  text: string;
}

const { headings } = Astro.props;
const items: Heading[] = (headings ?? []).filter((h: Heading) => h.depth <= 3);
---

{
  items.length > 0 && (
    <nav class="capsule-rail toc" aria-label="Sections">
      <details class="toc-fold">
        <summary class="capsule-label toc-h">Contents</summary>
        {items.map((h) => (
          <a class="toc-item" href={`#${h.slug}`} data-depth={h.depth}>
            {h.text}
          </a>
        ))}
      </details>
    </nav>
  )
}

<style>
  .toc {
    /* No top rule: the byline above already closes with one, and two hairlines
       70px apart read as a rendering mistake rather than as structure. */
    border-right: 0;
    border-top: 0;
    border-bottom: var(--rule-1) solid var(--border-hairline);
    padding: var(--space-3) 0;
    margin-bottom: var(--space-6);
  }
  .toc-h {
    margin: 0 0 var(--space-2);
    cursor: pointer;
    list-style: none;
  }
  .toc-h::-webkit-details-marker {
    display: none;
  }
  .toc-h::after {
    content: " +";
    color: var(--text-muted);
  }
  .toc-fold[open] > .toc-h::after {
    content: " \2212";
  }

  /* On a phone the contents are a closed fold: sixteen links ahead of the lede
     is two screens of preamble on the site's most valuable content. At the rail
     breakpoint the fold is forced open and the marker retires. */
  @media (min-width: 1080px) {
    .toc-fold {
      display: contents;
    }
    .toc-h {
      cursor: default;
    }
    .toc-h::after {
      content: none;
    }
  }
  .toc-item {
    font-family: var(--font-ui);
    font-size: var(--type-sm);
    min-height: var(--target-touch);
    display: flex;
    align-items: center;
    padding: 0 var(--space-3);
    color: var(--text-secondary);
    text-decoration: none;
  }
  .toc-item[data-depth="3"] {
    padding-left: var(--space-6);
  }
  .toc-item:hover {
    background: var(--state-hover);
    color: var(--text-primary);
  }
  .toc-item[aria-current] {
    background: var(--surface-inverted);
    color: var(--text-on-fill);
  }
  .toc-item:focus-visible {
    outline: var(--focus-ring-width) solid var(--focus-ring);
    outline-offset: calc(var(--focus-offset) * -1);
  }
</style>
