---
/* templates/index.astro — home, quiet register.
 * The content is the same as a portfolio home page; the presentation is not.
 * Deliberately absent: boxed credential cells, project cards with borders and
 * chip rows, an inverted contact slab, section counts. Someone who already has
 * the job does not need the page to argue. What is left is a standfirst, three
 * ruled lists, and one line about email. */
import Layout from "@layouts/Layout.astro";
import { getCollection } from "astro:content";
import { HOME, SITE, SOCIALS } from "@consts";
import { formatDate } from "@lib/utils";

const posts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("dev"))
  .filter((p) => !p.data.draft && !p.data.hidden && p.data.featured)
  .sort((a, b) => (a.data.featuredRank ?? 99) - (b.data.featuredRank ?? 99))
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION}>
  <section class="hero" aria-labelledby="hero-h">
    <h1 id="hero-h">
      Who gets seen, who gets counted, and the dignity of people who can't opt
      out.
    </h1>
    <p class="lede">
      Engineer, civic-AI builder, poet and theatermaker. {SITE.DESCRIPTION}
    </p>
    <!-- The credentials, as a sentence rather than four boxed cells. Same
         facts, no scaffolding. -->
    <p class="standing">
      Now on the AI/ML team at <strong>Grafana Labs</strong>. Before that,
      resiliency automation on <strong>IBM Z</strong>. Studying at
      <strong>NYU Tandon</strong>. Poems in Barzakh, Collide-oscope and Four
      Tulips.
    </p>
  </section>

  <section aria-labelledby="work-h">
    <h2 class="capsule-label section-h" id="work-h">Work</h2>
    <ul class="entries">
      {
        projects.map((p) => (
          <li>
            <a class="entry-title" href={`/dev/${p.id}`}>{p.data.title}</a>
            <p class="entry-note">{p.data.excerpt ?? p.data.description}</p>
            {
              (p.data.role || p.data.venue) && (
                <p class="entry-meta">
                  {[p.data.role, p.data.venue].filter(Boolean).join(" · ")}
                </p>
              )
            }
          </li>
        ))
      }
    </ul>
    <a class="capsule-link more" href="/dev">All projects</a>
  </section>

  <section aria-labelledby="writing-h">
    <h2 class="capsule-label section-h" id="writing-h">Writing</h2>
    <ul class="rows">
      {
        posts.map((p) => (
          <li>
            <a class="row-title" href={`/blog/${p.id}`}>{p.data.title}</a>
            <span class="row-when">{formatDate(p.data.date)}</span>
          </li>
        ))
      }
    </ul>
    <a class="capsule-link more" href="/blog">Everything</a>
  </section>

  <!-- Contact, at the volume of a footnote. -->
  <section class="contact" aria-labelledby="contact-h">
    <h2 class="capsule-label section-h" id="contact-h">Elsewhere</h2>
    <p>
      <a class="capsule-link" href="mailto:hello@adamr.io">hello@adamr.io</a>
      {
        SOCIALS.map((s) => (
          <>
            <span class="sep" aria-hidden="true">·</span>
            <a class="capsule-link" href={s.HREF} rel="me">{s.NAME}</a>
          </>
        ))
      }
    </p>
  </section>
</Layout>

<style>
  /* Rhythm does the work the borders used to: tight inside a group, generous
     between sections. Nothing here is boxed. */
  .hero {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding-bottom: var(--space-8);
  }
  .hero h1 {
    font-family: var(--font-head);
    font-weight: var(--font-weight-display);
    font-size: var(--text-display);
    line-height: 1.1;
    letter-spacing: var(--track-display);
    color: var(--text-primary);
    margin: 0;
    max-width: 30ch;
    text-wrap: balance;
  }
  .lede {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--text-lede);
    color: var(--text-body);
    text-wrap: pretty;
  }
  .standing {
    margin: 0;
    max-width: var(--measure);
    font-size: var(--type-sm);
    color: var(--text-secondary);
    text-wrap: pretty;
  }
  .standing strong { font-weight: var(--wt-medium); color: var(--text-primary); }

  section + section { margin-top: var(--space-8); }
  .section-h {
    font-weight: inherit;
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: var(--rule-1) solid var(--border-hairline);
  }

  /* Work: a list with room, not a grid of cards. */
  .entries { list-style: none; margin: 0; padding: 0; }
  .entries > li + li { margin-top: var(--space-5); }
  .entry-title {
    font-family: var(--font-head);
    font-size: var(--type-lg);
    font-weight: var(--font-weight-display);
    letter-spacing: var(--track-display);
    color: var(--text-primary);
    text-decoration: none;
    border-bottom: var(--rule-1) solid transparent;
  }
  .entry-title:hover { border-bottom-color: var(--accent-ink); }
  .entry-note {
    margin: var(--space-2) 0 0;
    max-width: var(--measure);
    color: var(--text-body);
    text-wrap: pretty;
  }
  .entry-meta {
    margin: var(--space-1) 0 0;
    font-family: var(--font-label);
    font-size: var(--type-xs);
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }

  /* Writing: ruled rows, no ordinals, no hover fill. */
  .rows { list-style: none; margin: 0; padding: 0; }
  .rows li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-2) 0;
    border-bottom: var(--rule-1) solid var(--border-hairline);
  }
  .row-title {
    font-family: var(--font-ui);
    font-weight: var(--wt-medium);
    color: var(--text-primary);
    text-decoration: none;
    min-height: var(--target-min);
    display: inline-flex;
    align-items: center;
  }
  .row-title:hover { border-bottom: var(--rule-1) solid var(--accent-ink); }
  .row-when {
    font-family: var(--font-label);
    font-size: var(--type-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  @media (max-width: 640px) {
    .rows li { grid-template-columns: 1fr; gap: 0; }
  }

  .more {
    display: inline-flex;
    align-items: center;
    min-height: var(--target-min);
    margin-top: var(--space-4);
    font-family: var(--font-label);
    font-size: var(--type-xs);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .contact p { margin: 0; display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; }
  .contact .sep { color: var(--text-muted); }
</style>
