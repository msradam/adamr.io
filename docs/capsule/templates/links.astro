---
/* templates/links.astro — links and contact.
 * Rows, not cards. The only accent is the link ink; the slab carries contact. */
import Layout from "@layouts/Layout.astro";
import { SOCIALS } from "@consts";

const elsewhere = [
  { name: "RSS", href: "/rss.xml", note: "Every post, no tracking" },
  { name: "Sitemap", href: "/sitemap-index.xml", note: "For machines" },
];
---

<Layout title="Links" description="Where else to find Adam M. Rahman.">
  <h1 class="page-h">Elsewhere</h1>

  <ul class="rows">
    {
      SOCIALS.map((s) => (
        <li>
          <a class="row-title" href={s.HREF} rel="me">{s.NAME}</a>
          <span class="row-note">{s.HREF.replace(/^https?:\/\//, "")}</span>
        </li>
      ))
    }
    {
      elsewhere.map((s) => (
        <li>
          <a class="row-title" href={s.href}>{s.name}</a>
          <span class="row-note">{s.note}</span>
        </li>
      ))
    }
  </ul>

  <section class="contact" aria-labelledby="c-h">
    <h2 class="capsule-label section-h" id="c-h">Email</h2>
    <p>
      <a class="capsule-link" href="mailto:hello@adamr.io">hello@adamr.io</a> —
      the most reliable way to reach me.
    </p>
  </section>
</Layout>

<style>
  .page-h {
    font-family: var(--font-head);
    font-size: var(--text-display);
    font-weight: var(--font-weight-display);
    letter-spacing: var(--track-display);
    color: var(--text-primary);
    margin: var(--space-2) 0 var(--space-6);
  }
  .rows { list-style: none; margin: 0 0 var(--space-7); padding: 0; }
  .rows li {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    gap: var(--space-3);
    padding: var(--space-2) var(--space-1);
    border-top: var(--rule-1) solid var(--border-hairline);
  }
  .rows li:last-child { border-bottom: var(--rule-1) solid var(--border-hairline); }
  .row-title {
    font-family: var(--font-ui);
    font-weight: var(--wt-medium);
    color: var(--text-primary);
    text-decoration: none;
    min-height: var(--target-touch);
    display: inline-flex;
    align-items: center;
  }
  .row-title:hover { border-bottom: var(--rule-1) solid var(--accent-ink); }
  .row-note {
    font-family: var(--font-label);
    font-size: var(--type-xs);
    letter-spacing: 0.06em;
    color: var(--text-muted);
  }
  @media (max-width: 640px) {
    .rows li { grid-template-columns: 1fr; gap: var(--space-1); }
  }

  .contact p { margin: 0; max-width: var(--measure); color: var(--text-body); }
  .section-h {
    font-weight: inherit;
    margin: 0 0 var(--space-4);
    padding-bottom: var(--space-2);
    border-bottom: var(--rule-1) solid var(--border-hairline);
  }
</style>
